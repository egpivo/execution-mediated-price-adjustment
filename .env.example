# Copy to .env and fill in as needed:
#   cp .env.example .env
#
# Loaded automatically by research_core.paths.bootstrap_env()
# (os.environ.setdefault — exported shell vars win).
# Never commit .env.

# --- Mode C: archival RPC (required for eth_pool_events.py) ---
# Any archive-capable JSON-RPC endpoint works; Alchemy is the usual setup.
ALCHEMY_ETHEREUM_URL=
ALCHEMY_BASE_URL=
# If ALCHEMY_BASE_URL is empty and ALCHEMY_ETHEREUM_URL uses
# eth-mainnet.g.alchemy.com, Base is derived by hostname substitution.

# Optional RPC hygiene (defaults shown)
# AMM_RPC_SLEEP=0
# AMM_RPC_RETRIES=16
# AMM_RPC_RATE_LIMIT_SLEEP=30
# AMM_RPC_RATE_LIMIT_CAP=600

# --- Paths (optional; defaults are under this repo) ---
# RESEARCH_CORE_DATA_ROOT=            # default: <repo>/data
# RESEARCH_CORE_EXTERNAL_CACHE=       # default: <repo>/data/external_cache
#                                     # Mode B: point at your response-panel cache root
# RESEARCH_CORE_RAW_AMM_ROOT=         # default: <repo>/data/raw/pool_events
# RESEARCH_CORE_LEGACY_BRIDGE_PARQUET=
